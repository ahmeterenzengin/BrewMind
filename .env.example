# Genel
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True

# Veritabani (Local Docker)
DB_NAME=coffee_rag
DB_USER=coffee_user
DB_PASSWORD=coffee_pass
DB_HOST=localhost
DB_PORT=5432

# Veritabani (Bulut - Supabase). DATABASE_URL varsa yukardaki DB_ ayarlari devre disi kalir.
# DATABASE_URL=postgresql://postgres:SIFRENIZ@db.xxxx.supabase.co:5432/postgres

# LM Studio (Local)
LLM_PROVIDER=LM_STUDIO
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-4-e4b

# Gemini API (Bulut). LLM_PROVIDER=GEMINI yapinca aktif olur.
# LLM_PROVIDER=GEMINI
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# Claude API (Opsiyonel)
# ANTHROPIC_API_KEY=sk-ant-...

# CORS (Bulut - Vercel veya Render linkinizi buraya ekleyin)
# CORS_ALLOWED_ORIGINS=https://brewmind.vercel.app
